<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Post Moderation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin/dashboard">Blog Admin</a>
      <a class="btn btn-outline-light btn-sm" href="/admin/users">Manage Users</a>
    </div>
  </nav>

  <main class="container py-4">
    <h1 class="h2 mb-4">Blog Post Moderation</h1>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th>Title</th>
              <th>Author</th>
              <th>Created Date</th>
              <th>Edit</th>
              <th>Delete</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><%= post.title %></td>
                <td><%= post.author ? post.author.name : "Deleted user" %></td>
                <td><%= post.createdAt.toLocaleDateString() %></td>
                <td>
                  <a class="btn btn-sm btn-primary"
                     href="/admin/posts/<%= post._id %>/edit">
                    Edit
                  </a>
                </td>
                <td>
                  <form action="/admin/posts/<%= post._id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Delete this blog post?')">
                    <button class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>

            <% if (posts.length === 0) { %>
              <tr><td colspan="5">No blog posts found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <a class="btn btn-secondary mt-3" href="/admin/dashboard">
      Back to Dashboard
    </a>
  </main>
</body>
</html>