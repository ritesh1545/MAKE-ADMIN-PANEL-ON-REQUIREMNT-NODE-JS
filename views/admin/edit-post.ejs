<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Blog Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5" style="max-width: 850px">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Edit Blog Post</h1>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/admin/posts/<%= post._id %>/edit" method="POST">
          <div class="mb-3">
            <label class="form-label" for="title">Post Title</label>
            <input class="form-control" id="title" name="title"
                   value="<%= post.title %>" maxlength="200" required>
          </div>

          <div class="mb-3">
            <label class="form-label" for="content">Post Content</label>
            <textarea class="form-control" id="content" name="content"
                      rows="10" required><%= post.content %></textarea>
          </div>

          <button class="btn btn-primary">Save Changes</button>
          <a href="/admin/posts" class="btn btn-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </main>
</body>
</html>