<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Blog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">My Blog</a>

      <% if (currentUserId) { %>
        <% if (currentUserRole === 'admin') { %>
          <a class="btn btn-warning btn-sm" href="/admin/dashboard">
            Admin Panel
          </a>
        <% } %>

        <form action="/logout" method="POST">
          <button class="btn btn-outline-light btn-sm">Logout</button>
        </form>
      <% } else { %>
        <div>
          <a href="/login" class="btn btn-outline-light btn-sm">Login</a>
          <a href="/register" class="btn btn-primary btn-sm">Register</a>
        </div>
      <% } %>
    </div>
  </nav>

  <main class="container py-4">
    <h1 class="mb-4">Latest Blog Posts</h1>

    <% if (currentUserId) { %>
      <div class="card mb-4">
        <div class="card-body">
          <h2 class="h5">Create a Blog Post</h2>

          <form action="/posts" method="POST">
            <div class="mb-3">
              <input class="form-control" name="title"
                     placeholder="Post title" maxlength="200" required>
            </div>

            <div class="mb-3">
              <textarea class="form-control" name="content"
                        rows="4" placeholder="Write your post..."
                        required></textarea>
            </div>

            <button class="btn btn-primary">Publish Post</button>
          </form>
        </div>
      </div>
    <% } %>

    <% posts.forEach(post => { %>
      <article class="card mb-3 shadow-sm">
        <div class="card-body">
          <h2 class="h4"><%= post.title %></h2>
          <p><%= post.content %></p>
          <small class="text-muted">
            By <%= post.author ? post.author.name : "Deleted user" %>
            · <%= post.createdAt.toLocaleDateString() %>
          </small>
        </div>
      </article>
    <% }) %>

    <% if (posts.length === 0) { %>
      <p>No blog posts yet. Register or log in to create one.</p>
    <% } %>
  </main>
</body>
</html>